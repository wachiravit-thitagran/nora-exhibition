# เทมเพลตของ nginx ในคอนเทนเนอร์ — ตัวแปร ${...} ถูกแทนค่าตอนคอนเทนเนอร์เริ่มทำงาน
# (docker-entrypoint ของอิมเมจ nginx รัน envsubst ให้ไฟล์ใน /etc/nginx/templates/)
#
# ข้อกำหนด: service นี้ตอบเฉพาะ /exhibition/* เท่านั้น
#   ทุก path ที่สไลด์ต้องใช้จึงอยู่ใต้ /exhibition/ ทั้งหมด รวมทั้งวิดีโอที่ต้องดึง
#   จากแอป ainora (proxy ต่อให้ที่ /exhibition/videos/) และ health check
#   อะไรที่อยู่นอก /exhibition/ ตอบ 404 ทั้งหมด
#
#   AINORA_UPSTREAM  ปลายทางของ /exhibition/videos/ และ /exhibition/static/
#                    ค่าเริ่มต้น https://ainora.psu.ac.th (ห้ามมี / ปิดท้าย)
#                    ถ้าแอป ainora อยู่ใน docker network เดียวกัน ชี้ตรงได้เลย
#                    เช่น http://ainora-app:8000

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    server_tokens off;
    add_header X-Content-Type-Options nosniff always;

    gzip on;
    gzip_types text/html text/css application/javascript image/svg+xml application/json;
    gzip_min_length 1024;

    # คลิปมีขนาดหลาย MB ปล่อยให้ nginx สตรีมตรงไม่ต้องบัฟทั้งก้อน
    proxy_buffering off;
    proxy_read_timeout 300s;

    # ---- นอก /exhibition/ ไม่ให้บริการ -------------------------------
    location / {
        return 404;
    }

    location = /exhibition {
        return 301 /exhibition/;
    }

    # ---- health check ------------------------------------------------
    location = /exhibition/healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # ---- วิดีโอ 22 คลิปจากแอป ainora ---------------------------------
    # สไลด์ตั้ง AINORA_BASE = '/exhibition' จึงเรียกมาที่ /exhibition/videos/<id>/file
    # ที่นี่ตัดคำนำหน้า /exhibition ออกแล้วส่งต่อเป็น /videos/<id>/file ที่ต้นทาง
    location /exhibition/videos/ {
        proxy_pass         ${AINORA_UPSTREAM}/videos/;
        proxy_set_header   Host              ${AINORA_HOST};
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_name     ${AINORA_HOST};
        # คลิปเดิมไม่เปลี่ยน ให้เบราว์เซอร์แคชได้ยาว ลดภาระต้นทางตอนวนลูปทั้งวัน
        proxy_hide_header  Cache-Control;
        add_header         Cache-Control "public, max-age=86400";
    }

    # ภาพพื้นหลังลายไทยจากหน้าเว็บหลัก
    location /exhibition/static/ {
        proxy_pass       ${AINORA_UPSTREAM}/static/;
        proxy_set_header Host ${AINORA_HOST};
        proxy_ssl_server_name on;
        proxy_ssl_name   ${AINORA_HOST};
        expires 7d;
    }

    # ---- ตัวสไลด์ ----------------------------------------------------
    # ห้ามแคช เพราะแก้เนื้อหาแล้วต้องเห็นผลทันทีตอนรีเฟรชจอนิทรรศการ
    location = /exhibition/index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    location = /exhibition/ {
        add_header Cache-Control "no-store, must-revalidate";
        try_files /exhibition/index.html =404;
    }

    location ^~ /exhibition/brand/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location ^~ /exhibition/assets/ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # เครื่องมือเลือกเฟรมเป็นของทีมงาน ไม่ใช่ของผู้เข้าชม
    # แก้ allow ให้ตรงกับซับเน็ตของสำนักงานก่อนใช้จริง
    location ^~ /exhibition/tools/ {
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        autoindex off;
    }

    location /exhibition/ {
        try_files $uri $uri/ =404;
    }
}
